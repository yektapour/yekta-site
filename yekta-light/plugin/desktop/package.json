{
  "name": "yekta-light",
  "productName": "Yekta Light",
  "version": "2.0.0",
  "description": "Yekta Light 3D lighting color picker — floating window for Clip Studio Paint (and any painting app)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.yekta.light.desktop",
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": { "icon": "app/icon.png" },
    "mac": { "icon": "app/icon.png", "category": "public.app-category.graphics-design" }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
