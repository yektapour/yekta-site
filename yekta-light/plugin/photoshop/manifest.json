{
  "manifestVersion": 5,
  "id": "com.yekta.light",
  "name": "Yekta Light",
  "version": "2.1.0",
  "main": "index.html",
  "host": [{ "app": "PS", "minVersion": "23.3.0" }],
  "requiredPermissions": { "clipboard": "readAndWrite" },
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "yektaPanel",
      "label": { "default": "Yekta Light" },
      "minimumSize": { "width": 240, "height": 360 },
      "maximumSize": { "width": 900, "height": 3000 },
      "preferredDockedSize": { "width": 300, "height": 900 },
      "preferredFloatingSize": { "width": 300, "height": 900 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"], "species": ["generic"] }
      ]
    }
  ]
}
